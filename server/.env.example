# ---- Notez server environment ----
# Copy this file to `server/.env` (local development) or set these as
# environment variables on your host (Vercel / Render / Railway).

# MongoDB connection string (MongoDB Atlas recommended for production)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/notez?retryWrites=true&w=majority

# Secret used to sign JWTs. Use a long, random string in production.
JWT_SECRET=replace-with-a-long-random-secret

# How long JWT + session cookies remain valid (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (used for CORS in dev).
# In production on Vercel the frontend and API share one origin.
CLIENT_URL=http://localhost:5173

# Port for the local Express server
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Set to "true" in production to mark auth cookies Secure
COOKIE_SECURE=false